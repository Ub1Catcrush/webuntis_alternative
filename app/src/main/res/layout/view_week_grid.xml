<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/week_body_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Fixed time gutter: header spacer + absolutely positioned time labels -->
            <LinearLayout
                android:id="@+id/week_gutter_column"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:id="@+id/week_gutter_spacer"
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />

                <FrameLayout
                    android:id="@+id/week_gutter_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- Day columns fill the entire remaining screen width, split evenly -->
            <LinearLayout
                android:id="@+id/week_day_columns"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</merge>
